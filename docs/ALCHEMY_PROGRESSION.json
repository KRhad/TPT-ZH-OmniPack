{
  "schema_version": 1,
  "content_version": "0.4.0-dev",
  "progress_schema": {
    "current": 1,
    "minimum_supported": 1,
    "migration_policy": "identifier_only",
    "unknown_schema_behavior": "reset_to_initial_without_modifying_source_save"
  },
  "mode_policy": {
    "default_enabled": false,
    "normal_sandbox_behavior": "all_implemented_elements_selectable",
    "activation_preference": "Omni.Progress.AlchemyMode",
    "progress_storage": "OPS.omniAlchemy",
    "paste_imports_progress": false,
    "locked_lua_behavior": "reject_without_mutation",
    "module_disabled_behavior": "complete_stage_and_preserve_hidden_unlocks",
    "corrupt_progress_behavior": "reset_to_initial_without_modifying_source_save"
  },
  "bounds": {
    "stage_count": 10,
    "scan_interval_frames": 30,
    "max_particles_per_frame": 8192,
    "max_saved_identifiers": 512,
    "max_saved_stages": 10,
    "max_saved_records": 64,
    "max_identifier_bytes": 64,
    "max_stage_id_bytes": 32
  },
  "required_condition_types": [
    "temperature",
    "pressure",
    "electric",
    "catalyst",
    "time",
    "structure",
    "cooling",
    "filtering",
    "multi_stage"
  ],
  "initial_identifiers": [
    "DEFAULT_PT_FIRE",
    "DEFAULT_PT_WATR",
    "DEFAULT_PT_STNE",
    "DEFAULT_PT_O2"
  ],
  "stages": [
    {
      "id": "A01-STEAM-CYCLE",
      "order": 1,
      "name_key": "alchemy.stage.a01.name",
      "hint_key": "alchemy.stage.a01.hint",
      "notice_key": "alchemy.stage.a01.notice",
      "module_dependencies": [],
      "inputs": ["DEFAULT_PT_FIRE", "DEFAULT_PT_WATR"],
      "outputs": ["DEFAULT_PT_WTRV"],
      "conditions": [
        {"type": "temperature", "target": "DEFAULT_PT_WTRV", "minimum_kelvin": 373.15},
        {"type": "time", "continuous_frames": 120}
      ],
      "failure_behavior": "retain_progress_no_unlock"
    },
    {
      "id": "A02-THERMAL-CYCLE",
      "order": 2,
      "name_key": "alchemy.stage.a02.name",
      "hint_key": "alchemy.stage.a02.hint",
      "notice_key": "alchemy.stage.a02.notice",
      "module_dependencies": [],
      "inputs": ["DEFAULT_PT_FIRE", "DEFAULT_PT_STNE", "DEFAULT_PT_WTRV"],
      "outputs": ["DEFAULT_PT_LAVA", "DEFAULT_PT_SAND", "DEFAULT_PT_BRCK"],
      "conditions": [
        {"type": "temperature", "target": "DEFAULT_PT_LAVA", "minimum_kelvin": 973.15},
        {"type": "cooling", "heat_target": "DEFAULT_PT_LAVA", "minimum_kelvin": 973.15, "cool_target": "DEFAULT_PT_STNE", "maximum_kelvin": 500.0},
        {"type": "multi_stage", "requires": ["A01-STEAM-CYCLE"]}
      ],
      "failure_behavior": "retain_progress_no_unlock"
    },
    {
      "id": "A03-CONTAINED-PRESSURE",
      "order": 3,
      "name_key": "alchemy.stage.a03.name",
      "hint_key": "alchemy.stage.a03.hint",
      "notice_key": "alchemy.stage.a03.notice",
      "module_dependencies": [],
      "inputs": ["DEFAULT_PT_WTRV", "DEFAULT_PT_BRCK"],
      "outputs": ["DEFAULT_PT_METL", "DEFAULT_PT_BTRY", "DEFAULT_PT_PUMP"],
      "conditions": [
        {"type": "pressure", "target": "DEFAULT_PT_WTRV", "minimum_absolute_pressure": 1.5},
        {"type": "structure", "targets": ["DEFAULT_PT_WTRV", "DEFAULT_PT_BRCK"], "maximum_radius": 12},
        {"type": "time", "continuous_frames": 180}
      ],
      "failure_behavior": "retain_progress_no_unlock"
    },
    {
      "id": "A04-CLOSED-CIRCUIT",
      "order": 4,
      "name_key": "alchemy.stage.a04.name",
      "hint_key": "alchemy.stage.a04.hint",
      "notice_key": "alchemy.stage.a04.notice",
      "module_dependencies": [],
      "inputs": ["DEFAULT_PT_BTRY", "DEFAULT_PT_METL"],
      "outputs": ["DEFAULT_PT_SPRK", "DEFAULT_PT_PSCN", "DEFAULT_PT_NSCN"],
      "conditions": [
        {"type": "electric", "target": "DEFAULT_PT_SPRK", "minimum_count": 1},
        {"type": "structure", "targets": ["DEFAULT_PT_BTRY", "DEFAULT_PT_METL", "DEFAULT_PT_SPRK"], "maximum_radius": 8},
        {"type": "time", "continuous_frames": 120}
      ],
      "failure_behavior": "retain_progress_no_unlock"
    },
    {
      "id": "A05-CATALYTIC-ELECTROLYSIS",
      "order": 5,
      "name_key": "alchemy.stage.a05.name",
      "hint_key": "alchemy.stage.a05.hint",
      "notice_key": "alchemy.stage.a05.notice",
      "module_dependencies": [],
      "inputs": ["DEFAULT_PT_WATR", "DEFAULT_PT_O2", "DEFAULT_PT_SPRK", "DEFAULT_PT_METL"],
      "outputs": ["DEFAULT_PT_H2", "DEFAULT_PT_ACID"],
      "conditions": [
        {"type": "electric", "target": "DEFAULT_PT_SPRK", "minimum_count": 1},
        {"type": "catalyst", "target": "DEFAULT_PT_METL", "minimum_count": 4},
        {"type": "time", "continuous_frames": 240}
      ],
      "failure_behavior": "retain_progress_no_unlock"
    },
    {
      "id": "A06-GRANULAR-FILTRATION",
      "order": 6,
      "name_key": "alchemy.stage.a06.name",
      "hint_key": "alchemy.stage.a06.hint",
      "notice_key": "alchemy.stage.a06.notice",
      "module_dependencies": [],
      "inputs": ["DEFAULT_PT_WATR", "DEFAULT_PT_SAND", "DEFAULT_PT_BRCK"],
      "outputs": ["DEFAULT_PT_FILT", "DEFAULT_PT_PIPE", "DEFAULT_PT_GLAS"],
      "conditions": [
        {"type": "filtering", "medium": "DEFAULT_PT_SAND", "fluid": "DEFAULT_PT_WATR", "minimum_count_each": 4},
        {"type": "structure", "targets": ["DEFAULT_PT_WATR", "DEFAULT_PT_SAND", "DEFAULT_PT_BRCK"], "maximum_radius": 12},
        {"type": "time", "continuous_frames": 300}
      ],
      "failure_behavior": "retain_progress_no_unlock"
    },
    {
      "id": "A07-INDUSTRIAL-FURNACE",
      "order": 7,
      "name_key": "alchemy.stage.a07.name",
      "hint_key": "alchemy.stage.a07.hint",
      "notice_key": "alchemy.stage.a07.notice",
      "module_dependencies": ["metallurgy"],
      "inputs": ["DEFAULT_PT_LAVA", "DEFAULT_PT_PIPE", "DEFAULT_PT_METL"],
      "outputs": ["DEFAULT_PT_CRMC", "DEFAULT_PT_COAL", "OMNI_PT_ALUM", "OMNI_PT_COPR", "OMNI_PT_TIN", "OMNI_PT_NICL"],
      "conditions": [
        {"type": "temperature", "target": "DEFAULT_PT_LAVA", "minimum_kelvin": 1375.0},
        {"type": "pressure", "target": "DEFAULT_PT_LAVA", "minimum_absolute_pressure": 2.0},
        {"type": "catalyst", "target": "DEFAULT_PT_FIRE", "minimum_count": 4},
        {"type": "multi_stage", "requires": ["A06-GRANULAR-FILTRATION"]}
      ],
      "failure_behavior": "complete_and_record_official_outputs_when_module_disabled"
    },
    {
      "id": "A08-SELECTIVE-CHEMISTRY",
      "order": 8,
      "name_key": "alchemy.stage.a08.name",
      "hint_key": "alchemy.stage.a08.hint",
      "notice_key": "alchemy.stage.a08.notice",
      "module_dependencies": ["chemistry"],
      "inputs": ["DEFAULT_PT_ACID", "DEFAULT_PT_WATR", "DEFAULT_PT_FILT"],
      "outputs": ["DEFAULT_PT_SALT", "OMNI_PT_FERT"],
      "conditions": [
        {"type": "filtering", "medium": "DEFAULT_PT_FILT", "fluid": "DEFAULT_PT_ACID", "minimum_count_each": 2},
        {"type": "cooling", "heat_target": "DEFAULT_PT_ACID", "minimum_kelvin": 330.0, "cool_target": "DEFAULT_PT_WATR", "maximum_kelvin": 295.0},
        {"type": "catalyst", "target": "DEFAULT_PT_SAND", "minimum_count": 2},
        {"type": "time", "continuous_frames": 240}
      ],
      "failure_behavior": "complete_and_record_official_outputs_when_module_disabled"
    },
    {
      "id": "A09-CONTROLLED-TRANSFER",
      "order": 9,
      "name_key": "alchemy.stage.a09.name",
      "hint_key": "alchemy.stage.a09.hint",
      "notice_key": "alchemy.stage.a09.notice",
      "module_dependencies": [],
      "inputs": ["DEFAULT_PT_PUMP", "DEFAULT_PT_FILT", "DEFAULT_PT_PIPE", "DEFAULT_PT_SPRK"],
      "outputs": ["DEFAULT_PT_INST", "DEFAULT_PT_CONV"],
      "conditions": [
        {"type": "pressure", "target": "DEFAULT_PT_PUMP", "minimum_absolute_pressure": 2.0},
        {"type": "electric", "target": "DEFAULT_PT_SPRK", "minimum_count": 1},
        {"type": "structure", "targets": ["DEFAULT_PT_PUMP", "DEFAULT_PT_FILT", "DEFAULT_PT_PIPE", "DEFAULT_PT_SPRK"], "maximum_radius": 16},
        {"type": "time", "continuous_frames": 360}
      ],
      "failure_behavior": "retain_progress_no_unlock"
    },
    {
      "id": "A10-MASTERY-LOOP",
      "order": 10,
      "name_key": "alchemy.stage.a10.name",
      "hint_key": "alchemy.stage.a10.hint",
      "notice_key": "alchemy.stage.a10.notice",
      "module_dependencies": [],
      "inputs": ["DEFAULT_PT_H2", "DEFAULT_PT_O2", "DEFAULT_PT_CRMC", "DEFAULT_PT_INST"],
      "outputs": ["DEFAULT_PT_DMND"],
      "conditions": [
        {"type": "temperature", "target": "DEFAULT_PT_FIRE", "minimum_kelvin": 1000.0},
        {"type": "pressure", "target": "DEFAULT_PT_H2", "minimum_absolute_pressure": 3.0},
        {"type": "electric", "target": "DEFAULT_PT_SPRK", "minimum_count": 1},
        {"type": "catalyst", "target": "DEFAULT_PT_CRMC", "minimum_count": 4},
        {"type": "structure", "targets": ["DEFAULT_PT_H2", "DEFAULT_PT_O2", "DEFAULT_PT_CRMC", "DEFAULT_PT_INST"], "maximum_radius": 20},
        {"type": "cooling", "heat_target": "DEFAULT_PT_FIRE", "minimum_kelvin": 1000.0, "cool_target": "DEFAULT_PT_CRMC", "maximum_kelvin": 350.0},
        {"type": "filtering", "medium": "DEFAULT_PT_FILT", "fluid": "DEFAULT_PT_H2", "minimum_count_each": 2},
        {"type": "time", "continuous_frames": 600},
        {"type": "multi_stage", "requires": ["A09-CONTROLLED-TRANSFER"]}
      ],
      "failure_behavior": "retain_progress_no_unlock"
    }
  ],
  "completion": {
    "requires_stage": "A10-MASTERY-LOOP",
    "grant_policy": "all_implemented_selectable_identifiers",
    "notice_key": "alchemy.mastery.notice"
  }
}
