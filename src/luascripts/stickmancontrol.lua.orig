#ifdef LUACONSOLE
#ifdef _MSC_VER
#include "common/Platform.h"
#include "resource.h"
#endif
#include "luaconsole.h"

void luaopen_stickmancontrol(lua_State *l)
{
#ifndef _MSC_VER
	int stickmancontrol_luac_sz = /*#SIZE*/;
	const char* stickmancontrol_luac = /*#DATA*/;
	luaL_loadbuffer(l, stickmancontrol_luac, stickmancontrol_luac_sz, "@stickmancontrol.lua");
	lua_pcall(l, 0, 0, 0);
#else
	unsigned int size = 0;
	const char* data = NULL;
	Platform::LoadFileInResource(IDI_STICKMANCONTROL, LUASCRIPT, size, data);
	char *buffer = new char[size+1];
	::memcpy(buffer, data, size);
	buffer[size] = 0;
	luaL_loadbuffer(l, buffer, size, "@stickmancontrol.lua");
	lua_pcall(l, 0, 0, 0);
	delete[] buffer;
#endif
}
#endif
