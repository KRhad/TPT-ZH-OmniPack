#ifdef LUACONSOLE
#ifdef _MSC_VER
#include "common/Platform.h"
#include "resource.h"
#endif
#include "luaconsole.h"

void luaopen_compat(lua_State *l)
{
#ifndef _MSC_VER
	int compat_luac_sz = /*#SIZE*/;
	const char *compat_luac = /*#DATA*/;
	luaL_loadbuffer(l, compat_luac, compat_luac_sz, "@compat.lua");
	lua_pcall(l, 0, 0, 0);
#else
	unsigned int size = 0;
	const char* data = NULL;
	Platform::LoadFileInResource(IDI_COMPAT, LUASCRIPT, size, data);
	char *buffer = new char[size+1];
	::memcpy(buffer, data, size);
	buffer[size] = 0;
	luaL_loadbuffer(l, buffer, size, "@compat.lua");
	lua_pcall(l, 0, 0, 0);
	delete[] buffer;
#endif
}
#endif
