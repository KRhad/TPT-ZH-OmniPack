  "challenges": [
    {"id": "A01-TEMPERATURE", "scenario": "thermostatic-furnace", "expected_outcome": "hold the furnace below the trip threshold and complete a manual reset"},
    {"id": "A02-FEEDING", "scenario": "automatic-alloy", "expected_outcome": "deliver exactly one tin charge to a three-copper molten batch"},
    {"id": "A03-SORTING", "scenario": "waste-transfer", "expected_outcome": "release registered waste while retaining an unknown or blocked payload"},
    {"id": "A04-DISINFECTION", "scenario": "pathogen-disinfection", "expected_outcome": "dose peroxide only when a pathogen and safe treatment conditions are present"},
    {"id": "A05-EMERGENCY-STOP", "scenario": "emergency-stop", "expected_outcome": "stop all outputs and reject an early reset"},
    {"id": "A06-MULTI-MODULE", "scenario": "integrated-factory", "expected_outcome": "operate four bounded cells, isolate one fault, stop globally, and recover manually"}
  ]
}
