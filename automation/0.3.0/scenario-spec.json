  "runtime_contract": {
    "required_metrics": [
      "frames",
      "input_events",
      "output_events",
      "peak_events_per_frame",
      "blocked_events",
      "stop_event_delta",
      "recovery_assertions"
    ],
    "success_status": "OMNI_AUTOMATION_STATUS=PASS",
    "failure_status": "OMNI_AUTOMATION_STATUS=FAIL"
  },
  "scenarios": [
